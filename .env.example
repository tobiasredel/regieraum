# Regieraum – configuration. Copy to .env and adjust. Full list: docs/SPEC.md, section 2.

# Public address of the app. Microphone and camera need https (or localhost).
PS_BASE_URL=http://localhost:8000

# Interface language of a new installation: de or en. Can be changed later in the settings.
PS_LANG=en

# Host login. "password" (built in) needs PS_HOST_PASSWORD with at least 8 characters.
# "proxy" means a reverse proxy in front protects every path except the public ones (see README).
PS_HOST_AUTH=password
PS_HOST_PASSWORD=

# Where published episodes and the feed live: "local" (served by the app under /public) or "s3" (any S3 compatible
# storage, tested with Cloudflare R2). With s3, PS_PUBLIC_BASE_URL is the public address of the bucket.
PS_STORAGE=local
#PS_PUBLIC_BASE_URL=https://podcast-files.example.org
#PS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#PS_S3_BUCKET=
#PS_S3_ACCESS_KEY=
#PS_S3_SECRET_KEY=

# TURN relay for participants behind strict firewalls or on mobile networks: "none", "static" or "cloudflare".
PS_TURN_MODE=none
#PS_TURN_URLS=turn:turn.example.org:3478
#PS_TURN_USERNAME=
#PS_TURN_CREDENTIAL=
#PS_CF_TURN_KEY_ID=
#PS_CF_TURN_API_TOKEN=

# Optional AI features. Without the keys the studio, the audio pipeline and the feed work as usual.
# Research dossiers, live hints and show notes:
#ANTHROPIC_API_KEY=
# Live transcription for the companion:
#OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway for the live transcript (default https://api.openai.com/v1)
#OPENAI_BASE_URL=

# Optional notifications via ntfy (episode ready for review, processing failed, published).
#PS_NTFY_URL=https://ntfy.example.org/podcast
#PS_NTFY_USER=
#PS_NTFY_PASS=
